# Environment variables template for FastAPI server

# Port and environment configurations
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (JWT token authentication)
JWT_SECRET=generate_a_secure_random_key_here

# Database configurations (MongoDB setup)
MONGODB_URI=mongodb://localhost:27017/prepsprint
DATABASE_NAME=prepsprint

# AI Service configurations (OpenRouter or OpenAI API credentials)
OPENAI_API_KEY=your_api_key_here
# Uncomment if using OpenAI directly (defaults to OpenRouter if sk-or- prefix is matched)
# OPENAI_MODEL=gpt-3.5-turbo
# OPENROUTER_MODEL=google/gemini-2.5-flash

# SMTP Email configurations for password resets
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here

EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password_here

